// Generated by gdc:scaffold-devcontainer
{
  "name": "Numeral-js",

  // Attach a stable label so VS Code, IntelliJ, and CLI scripts can all locate the same
  // container via: docker ps --filter "label=devcontainer.repo=<repo-name>"
  "runArgs": ["--label", "devcontainer.repo=${localWorkspaceFolderBasename}"],

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    // ── Infrastructure (always present) ──────────────────────────────────────
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/stunt-doubles-core:latest": {},

    // ── AI agent commons (always present) ────────────────────────────────────
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/devcontainer-commons:latest": {
      "agentContextPath": "/workspace/.devcontainer/agent/agents-devcontainer.md",
      "allowGitPush": true
      // Production hostnames discovered: none — this repo has no backend calls to block.
      // "blockedHosts": "api.godaddy.com"
    },

    // ── AI agents ─────────────────────────────────────────────────────────────
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/claude-code:latest": {},

    // ── Language: Node.js ────────────────────────────────────────────────────
    // package.json engines.node is "*" (no pinned version) — using lts as a reasonable
    // default. .travis.yml pins 0.8/0.10, which are long EOL and not usable as current.
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },

    // ── GoDaddy Artifactory ───────────────────────────────────────────────────
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/gd-artifactory:latest": {
      "configureNpm": true
    }

    // No stunt-doubles service features — this is a pure formatting/manipulation
    // library with no backend/service dependencies to mock.
  },

  "remoteUser": "vscode",

  "containerEnv": {
    "ARTIFACTORY_EMAIL": "${localEnv:ARTIFACTORY_EMAIL}",
    "ARTIFACTORY_TOKEN": "${localEnv:ARTIFACTORY_TOKEN}",
    "GOCODE_API_TOKEN": "${localEnv:GOCODE_API_TOKEN}",
    "GOCODE_BASE_URL": "${localEnv:GOCODE_BASE_URL}",

    // ── Atlassian MCP (optional) ──────────────────────────────────────────────
    "ATLASSIAN_USERNAME": "${localEnv:ATLASSIAN_USERNAME}",
    "ATLASSIAN_API_TOKEN": "${localEnv:ATLASSIAN_API_TOKEN}"
  },

  "remoteEnv": {
    "GOCODE_API_TOKEN": "${localEnv:GOCODE_API_TOKEN}",
    "GOCODE_BASE_URL": "${localEnv:GOCODE_BASE_URL}",

    "GIT_TOKEN": "${localEnv:GIT_TOKEN}",
    "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",

    "ARTIFACTORY_EMAIL": "${localEnv:ARTIFACTORY_EMAIL}",
    "ARTIFACTORY_TOKEN": "${localEnv:ARTIFACTORY_TOKEN}"
  },

  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",

  "initializeCommand": "mkdir -p ${localWorkspaceFolder}/.devcontainer/.agent-state/claude /tmp/atlas-worktree-git-unset",

  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/.agent-state/claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:WORKTREE_GIT_DIR:/tmp/atlas-worktree-git-unset},target=${localEnv:WORKTREE_GIT_DIR:/tmp/atlas-worktree-git-unset},type=bind,consistency=cached"
  ],

  // No forwarded ports — this is a library with no server/listener and no
  // stunt-doubles service features wired.
  "forwardPorts": [],

  "portsAttributes": {},

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropics.claude-code",
        "GitHub.copilot",
        "eamodio.gitlens",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true
        }
      }
    },
    "jetbrains": {
